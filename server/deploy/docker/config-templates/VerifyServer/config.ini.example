[VerifyServer]
Host = 0.0.0.0
Port = 50051

[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456

# __EMAIL_*__ 启动时替换为同名环境变量
[Email]
Host = __EMAIL_HOST__
Port = __EMAIL_PORT__
User = __EMAIL_USER__
Pass = __EMAIL_PASS__
From = __EMAIL_FROM__
# CA 证书包路径：留空自动探测系统证书库（容器内为
# /etc/ssl/certs/ca-certificates.crt），只有私有 CA 才需要填绝对路径
CA =
