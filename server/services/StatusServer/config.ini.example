# StatusServer 配置模板：复制为 config.ini 后按本机修改
[StatusServer]
Host = 127.0.0.1
Port = 50052
[Mysql]
Host = 127.0.0.1
XPort = 33060
User = root
Passwd = 123456
Schema = xigu
[Redis]
Host = 127.0.0.1
Port = 6380
Passwd = 123456
[chatservers]
Name = chatserver1,chatserver2
[chatserver1]
Name = chatserver1
Host = 127.0.0.1
Port = 8090
[chatserver2]
Name = chatserver2
Host = 127.0.0.1
Port = 8091
